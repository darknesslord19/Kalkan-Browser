<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bar">

            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <FrameLayout
                    android:id="@+id/shieldBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/shieldIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="Kalkan"
                        android:src="@drawable/ic_shield" />

                    <TextView
                        android:id="@+id/shieldBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_badge"
                        android:gravity="center"
                        android:minWidth="16dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1A1205"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <AutoCompleteTextView
                    android:id="@+id/urlBar"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_url"
                    android:completionThreshold="1"
                    android:dropDownWidth="match_parent"
                    android:drawablePadding="8dp"
                    android:hint="Ara veya adres yaz"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:inputType="textUri"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/onBar"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <FrameLayout
                    android:id="@+id/mediaBtn"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Medya"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_movie" />

                    <TextView
                        android:id="@+id/mediaBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_badge"
                        android:gravity="center"
                        android:minWidth="16dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1A1205"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/reloadBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Yenile"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/findBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/findInput"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_url"
                    android:hint="Sayfada bul"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/onBar"
                    android:textColorHint="@color/muted" />

                <TextView
                    android:id="@+id/findCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:gravity="center"
                    android:textColor="@color/muted" />

                <ImageButton
                    android:id="@+id/findPrev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Önceki"
                    android:src="@drawable/ic_up" />

                <ImageButton
                    android:id="@+id/findNext"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sonraki"
                    android:src="@drawable/ic_down" />

                <ImageButton
                    android:id="@+id/findClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Kapat"
                    android:src="@drawable/ic_close" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:max="100"
            android:visibility="invisible"
            app:indicatorColor="@color/brand"
            app:trackThickness="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/webContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/bar"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backBtn"
                style="@style/BarButton"
                android:contentDescription="Geri"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/forwardBtn"
                style="@style/BarButton"
                android:contentDescription="İleri"
                android:src="@drawable/ic_forward" />

            <ImageButton
                android:id="@+id/homeBtn"
                style="@style/BarButton"
                android:contentDescription="Ana sayfa"
                android:src="@drawable/ic_home" />

            <FrameLayout
                android:id="@+id/tabsBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/tabsCount"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tabcount"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/onBar"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/menuBtn"
                style="@style/BarButton"
                android:contentDescription="Menü"
                android:src="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hoverToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
